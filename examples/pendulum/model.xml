<mujoco model="pendulum swing to target">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1"/>
    <body name="pendulum" pos="0 0 0">
      <joint name="hinge" type="hinge" axis="0 1 0" range="-1.2 1.2" damping="0.2"/>
      <geom name="rod" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.025" mass="0.4" rgba="0.2 0.45 0.8 1"/>
      <site name="tip" pos="0 0 -0.5" size="0.035" rgba="0.9 0.25 0.1 1"/>
    </body>
  </worldbody>
  <actuator>
    <position name="hinge_target" joint="hinge" kp="25" ctrlrange="-1.2 1.2" forcerange="-8 8"/>
  </actuator>
</mujoco>
