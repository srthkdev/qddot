<mujoco model="simcheck cartpole">
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" />
  <default>
    <joint damping="0.08" armature="0.01" />
    <geom friction="0.8 0.01 0.001" solref="0.01 1" />
  </default>
  <worldbody>
    <geom name="floor" type="plane" pos="0 0 -0.08" size="2 0.2 0.1" rgba="0.2 0.2 0.2 1" />
    <body name="cart" pos="0 0 0">
      <joint name="cart" type="slide" axis="1 0 0" limited="true" range="-1 1" damping="0.2" />
      <geom name="cart_geom" type="box" size="0.12 0.08 0.08" mass="1" />
      <body name="pole" pos="0 0 0.08">
        <joint name="pole" type="hinge" axis="0 1 0" damping="0.01" armature="0.002" />
        <geom name="pole_geom" type="capsule" fromto="0 0 0 0 0 0.6" size="0.025" mass="0.1" />
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="push" joint="cart" ctrlrange="-10 10" gear="1" />
  </actuator>
</mujoco>
