<mujoco model="runner_fixture">
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>
  <worldbody>
    <body name="floorbody" pos="0 0 0">
      <geom name="floor" type="plane" size="1 1 0.1" friction="1 0.005 0.0001"/>
    </body>
    <body name="pendulum" pos="0 0 0.5">
      <joint name="hinge" type="hinge" axis="0 1 0" range="-0.3 0.3" limited="true"/>
      <geom name="pendulum_geom" type="capsule" fromto="0 0 0 0.2 0 0" size="0.025" mass="0.2"/>
    </body>
    <body name="payload" pos="0.5 0 0.04">
      <joint name="payload_z" type="slide" axis="0 0 1" range="0 0.4" limited="true"/>
      <geom name="payload_geom" type="box" size="0.04 0.04 0.04" mass="0.2" friction="1 0.005 0.0001"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="hinge_motor" joint="hinge" ctrlrange="-2 2" ctrllimited="true" gear="1"/>
    <position name="lift" joint="payload_z" ctrlrange="0 0.4" ctrllimited="true" kp="40"/>
  </actuator>
</mujoco>
